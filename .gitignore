# Dependencies
node_modules/
.pnp
.pnp.js

# Toolchain / local environment
.cargo/
.rustup/
.trae/
.codex/

# Build outputs
dist/
dist-ssr/
.target/
target/
release/
out/
bundle/
# 临时构建目录（vite --outDir 产物 / 打包中间态，如 dist-check、dist-new、dist-old-070）
dist-check/
dist-new/
dist-old-*/
# 构建与调试产物
src-tauri/build_errors.txt

# Local env files
.env
.env.local
.env.*.local
.npmrc

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# OS files
.DS_Store
Thumbs.db
desktop.ini

# Rust
# 本项目是应用（binary crate），Cargo.lock **应当提交**以保证依赖与构建可复现
# （Tauri 官方模板同样不忽略它），因此这里不再忽略。
**/*.rs.bk

# Tauri
src-tauri/target/
src-tauri/gen/

# Installer / package outputs
*.exe
*.msi
*.msix
*.dmg
*.deb
*.rpm
*.AppImage
*.zip
# Inno Setup 打包前的暂存目录
installer/staging/

# Release 核验临时产物（下载的旧版本源码 / 校验和 / 一次性调试脚本）
installer/tmp_*
installer/StudyAgent-client-*/
installer/StudyAgent-*-sha256.txt

# 敏感文件（预防性规则）
# demo-data 位于仓库之外，但其中的 config/settings.json 含明文 API key；
# 一旦有人把它复制进仓库，这条规则可以兜住。
demo-data/config/settings.json

# Runtime data（仅仓库根目录的运行数据，不误伤 src-tauri/src/data/ 源码）
/data/
.cache/
*.state

# esbuild cache
.tmp-esbuild/

# Rust/toolchain build caches
src-tauri/.tmp/
